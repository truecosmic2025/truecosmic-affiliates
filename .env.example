# Postgres connection (Railway sets this automatically when you add a Postgres database)
DATABASE_URL="postgresql://user:pass@host:5432/db"
# Public URL of this app, e.g. https://affiliates.truecosmic.com
APP_URL="https://affiliates.truecosmic.com"
# Long random string used to sign login sessions: openssl rand -hex 32
SESSION_SECRET=""
# Long random string shared with the WordPress connector plugin: openssl rand -hex 32
WP_SHARED_SECRET=""
# Your WordPress site (where WooCommerce, FluentCRM and the connector plugin live)
WP_SITE_URL="https://www.truecosmic.com"
# Admin login, created/updated on every start
ADMIN_EMAIL="admin@truecosmic.com"
ADMIN_PASSWORD=""
