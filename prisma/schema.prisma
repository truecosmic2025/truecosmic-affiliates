generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AFFILIATE
}

enum AffiliateStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
}

enum RateType {
  PERCENTAGE
  FLAT
}

enum ReferralStatus {
  PENDING
  UNPAID
  PAID
  REJECTED
}

enum PayoutStatus {
  PROCESSING
  PAID
  FAILED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  role         Role       @default(AFFILIATE)
  passwordHash String?
  affiliate    Affiliate?
  createdAt    DateTime   @default(now())
}

model Affiliate {
  id                     String                 @id @default(cuid())
  legacyId               Int?                   @unique // AffiliateWP affiliate_id, keeps old ?ref=123 links working
  code                   String                 @unique // referral slug used in ?ref=
  aliases                String[]               @default([]) // other ?ref= values that credit this affiliate (old AffiliateWP username / custom slug), lowercase
  user                   User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId                 String?                @unique
  email                  String                 @unique
  firstName              String?
  lastName               String?
  paymentEmail           String?
  website                String?
  promotionPlan          String?
  status                 AffiliateStatus        @default(PENDING)
  rateType               RateType? // null = use global default
  rate                   Decimal?               @db.Decimal(10, 2)
  coupons                String[]               @default([])
  notes                  String?
  crmSyncedAt            DateTime?
  group                  AffiliateGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId                String?
  parent                 Affiliate?             @relation("Network", fields: [parentId], references: [id], onDelete: SetNull)
  parentId               String?
  children               Affiliate[]            @relation("Network")
  rejectionReason        String?
  registration           Json? // extra answers from the sign-up form
  signupIpHash           String?
  emailOnReferral        Boolean                @default(true)
  dynamicCoupon          String?
  visits                 Visit[]
  referrals              Referral[]
  payouts                Payout[]
  customers              Customer[]
  productRates           AffiliateProductRate[]
  landingPages           LandingPage[]
  directLinks            DirectLink[]
  bonusAwards            BonusAward[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  disputes               Dispute[]
  payoutMethod           String                 @default("paypal") // paypal | payoneer | wise | other
  payoutDetails          Json?
  pendingPayout          Json? // requested change, applied once confirmed by email
  pendingPayoutTokenHash String?
  pendingPayoutExpires   DateTime?
}

model Product {
  id                String                 @id @default(cuid())
  wcId              Int                    @unique
  name              String
  kind              String                 @default("other") // course | ebook | coaching | event | membership | other
  wcType            String? // WooCommerce product type, e.g. simple, subscription, event_ticket
  coach             String? // event host / coach whose deal sets the affiliate rate
  price             Decimal                @default(0) @db.Decimal(10, 2)
  permalink         String?
  status            String                 @default("publish")
  categories        String[]               @default([])
  commissionEnabled Boolean                @default(true)
  rateType          RateType?
  rate              Decimal?               @db.Decimal(10, 2)
  deleted           Boolean                @default(false)
  affiliateRates    AffiliateProductRate[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model Visit {
  id          String     @id @default(cuid())
  affiliate   Affiliate  @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId String
  url         String?
  referrer    String?
  campaign    String?
  ipHash      String?
  source      String     @default("link") // link | direct | landing | short
  flagged     String? // fraud flag reason, e.g. "ppc"
  converted   Boolean    @default(false)
  referrals   Referral[]
  createdAt   DateTime   @default(now())

  @@index([affiliateId, createdAt])
}

model Referral {
  id                 String         @id @default(cuid())
  legacyId           Int?           @unique
  affiliate          Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId        String
  visit              Visit?         @relation(fields: [visitId], references: [id], onDelete: SetNull)
  visitId            String?
  orderId            String? // WooCommerce order id (unique per affiliate+type, see below)
  orderTotal         Decimal        @default(0) @db.Decimal(10, 2)
  amount             Decimal        @db.Decimal(10, 2) // commission
  currency           String         @default("USD")
  status             ReferralStatus @default(UNPAID)
  description        String?
  items              Json?
  customerEmail      String?
  customerName       String?
  source             String         @default("link") // link | coupon | lifetime | manual | import | direct | landing
  type               String         @default("sale") // sale | recurring | tier | bonus | signup
  tierLevel          Int?
  parentReferral     Referral?      @relation("Tier", fields: [parentReferralId], references: [id], onDelete: Cascade)
  parentReferralId   String?
  tierReferrals      Referral[]     @relation("Tier")
  customer           Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId         String?
  campaign           String?
  flagged            String?
  notes              String?
  payout             Payout?        @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  payoutId           String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  clearsAt           DateTime? // end of the refund window; not payable before this
  // Store sells in GBP, commissions are owed in USD: the conversion is locked at the sale date
  originalCurrency   String?
  amountOriginal     Decimal?       @db.Decimal(12, 2)
  orderTotalOriginal Decimal?       @db.Decimal(12, 2)
  fxRate             Decimal?       @db.Decimal(18, 8)
  fxDate             DateTime?
  fxSource           String?
  disputes           Dispute[]

  @@unique([orderId, affiliateId, type])
  @@index([affiliateId, status])
  @@index([createdAt])
}

model Payout {
  id            String       @id @default(cuid())
  affiliate     Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId   String
  amount        Decimal      @db.Decimal(10, 2)
  currency      String       @default("USD")
  method        String       @default("paypal") // paypal | payoneer | wise | other
  status        PayoutStatus @default(PAID)
  reference     String?
  notes         String?
  kind          String       @default("run") // run | manual
  reason        String? // required for manual payouts (prize, settlement, correction)
  payTo         Json? // snapshot of the payout details used
  run           PayoutRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  runId         String?
  externalId    String? // PayPal payout item / batch id
  failureReason String?
  paidAt        DateTime?
  referrals     Referral[]
  disputes      Dispute[]
  createdAt     DateTime     @default(now())

  @@index([runId])
}

model PayoutRun {
  id            String   @id @default(cuid())
  approvedBy    String
  total         Decimal  @db.Decimal(12, 2)
  currency      String   @default("USD")
  summary       Json // per-method counts and totals at approval
  paypalBatchId String?
  payouts       Payout[]
  createdAt     DateTime @default(now())
}

model FxRate {
  id        String   @id @default(cuid())
  base      String
  quote     String
  day       String // YYYY-MM-DD the rate applies to (as requested)
  rateDate  String // YYYY-MM-DD the provider published (previous business day on weekends)
  rate      Decimal  @db.Decimal(18, 8)
  source    String
  createdAt DateTime @default(now())

  @@unique([base, quote, day])
}

model Creative {
  id          String   @id @default(cuid())
  name        String
  description String?
  url         String
  imageUrl    String?
  text        String?
  type        String   @default("image") // image | text | qr
  groupIds    String[] @default([]) // empty = visible to everyone
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Setting {
  key   String @id
  value Json
}

model EventLog {
  id        String   @id @default(cuid())
  kind      String // webhook:order.paid, crm:contact, import:affiliates ...
  status    String // ok | error | skipped
  message   String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
}

model AffiliateGroup {
  id         String      @id @default(cuid())
  name       String      @unique
  rateType   RateType?
  rate       Decimal?    @db.Decimal(10, 2)
  isDefault  Boolean     @default(false)
  affiliates Affiliate[]
  createdAt  DateTime    @default(now())
}

model AffiliateProductRate {
  id          String    @id @default(cuid())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  rateType    RateType
  rate        Decimal   @db.Decimal(10, 2)

  @@unique([affiliateId, productId])
}

model CategoryRate {
  id       String   @id @default(cuid())
  category String   @unique
  rateType RateType
  rate     Decimal  @db.Decimal(10, 2)
}

model RateTier {
  id        String   @id @default(cuid())
  metric    String // earnings | referrals (lifetime totals)
  threshold Decimal  @db.Decimal(12, 2)
  rateType  RateType
  rate      Decimal  @db.Decimal(10, 2)
}

model Customer {
  id          String     @id @default(cuid())
  email       String     @unique
  name        String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  affiliateId String? // lifetime link
  referrals   Referral[]
  createdAt   DateTime   @default(now())
}

model LandingPage {
  id          String    @id @default(cuid())
  path        String    @unique // e.g. /academy/jane/
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId String
  createdAt   DateTime  @default(now())
}

model DirectLink {
  id          String    @id @default(cuid())
  domain      String    @unique
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId String
  status      String    @default("pending") // pending | approved | rejected
  createdAt   DateTime  @default(now())
}

model Bonus {
  id        String       @id @default(cuid())
  name      String
  metric    String // referrals | earnings | signup
  threshold Decimal      @default(0) @db.Decimal(12, 2)
  amount    Decimal      @db.Decimal(10, 2)
  active    Boolean      @default(true)
  awards    BonusAward[]
  createdAt DateTime     @default(now())
}

model BonusAward {
  id          String    @id @default(cuid())
  bonus       Bonus     @relation(fields: [bonusId], references: [id], onDelete: Cascade)
  bonusId     String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId String
  createdAt   DateTime  @default(now())

  @@unique([bonusId, affiliateId])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  prefix     String
  scopes     String[]  @default(["full"])
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Webhook {
  id        String   @id @default(cuid())
  url       String
  events    String[] // affiliate.created, affiliate.approved, referral.created, referral.updated, payout.created, or *
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Promotion {
  id         String    @id @default(cuid())
  name       String
  rateType   RateType
  rate       Decimal   @db.Decimal(10, 2)
  startsAt   DateTime?
  endsAt     DateTime?
  categories String[]  @default([]) // empty with no products = whole store
  productIds String[]  @default([]) // Product.id values
  groupIds   String[]  @default([]) // empty = all affiliates
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

model Dispute {
  id          String           @id @default(cuid())
  affiliate   Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId String
  referral    Referral?        @relation(fields: [referralId], references: [id], onDelete: SetNull)
  referralId  String?
  payout      Payout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  payoutId    String?
  category    String // missing | amount | payout | rejected | other
  subject     String
  orderRef    String? // order number the affiliate believes is theirs
  status      String           @default("open") // open | in_review | resolved | declined
  messages    DisputeMessage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
}

model DisputeMessage {
  id         String   @id @default(cuid())
  dispute    Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  disputeId  String
  author     String // affiliate | staff
  authorName String?
  body       String
  createdAt  DateTime @default(now())
}

// Affiliate commission agreed with a coach, applied to all of their events (case by case)
model CoachDeal {
  id        String   @id @default(cuid())
  coach     String   @unique
  rateType  RateType
  rate      Decimal  @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
